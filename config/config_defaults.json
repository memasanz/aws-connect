{
  "description": "Default values for the OneLake `config` delta table. Loaded by nb_setup_01_bootstrap. Auth is hybrid: Document Intelligence + Azure OpenAI are keyless Entra (disableLocalAuth policy); Azure AI Search uses an admin key read from Key Vault (kv_name/search_key_secret). No secret values are stored here. See PRODUCT_SPEC.md sections 6 and 14.",
  "config": {
    "acl_bypass_enabled": "false",
    "acls_file_path": "Files/acls/acls.json",
    "source_mode": "s3_shortcut",
    "shortcut_root": "Files/s3_mmx_bucket",
    "s3_endpoint_url": "https://s3.<your-region>.amazonaws.com",
    "s3_bucket": "<your-bucket>",
    "s3_prefix": "",
    "s3_region": "us-east-1",
    "s3_addressing": "path",
    "s3_verify_tls": "true",
    "s3_access_key_secret": "s3-access-key",
    "s3_secret_key_secret": "s3-secret-key",

    "doc_intelligence_endpoint": "https://<your-di>.cognitiveservices.azure.com/",
    "doc_intelligence_model": "prebuilt-layout",

    "aoai_endpoint": "https://<your-aoai>.openai.azure.com/",
    "aoai_embedding_deployment": "text-embedding-3-large",
    "embedding_dimensions": "3072",

    "search_endpoint": "https://<your-search>.search.windows.net",
    "search_index_name": "docs-rag",
    "search_key_secret": "search-admin-key",

    "chunk_size": "8000",
    "chunk_strategy_version": "page-v1",

    "max_concurrency": "8",
    "max_retries": "3",
    "ingesting_lease_minutes": "120",
    "batch_size": "100",
    "max_batches_per_run": "0",
    "run_time_budget_min": "0",
    "supported_extensions": "pdf,docx,pptx,xlsx,html,htm,txt,md",
    "backfill_mode": "false",
    "backfill_batch_size": "500",

    "kv_name": "<your-keyvault-name>"
  }
}
