# Copy this file to `.env` and fill in your workspace's values. `.env` is gitignored.
# The run_* scripts (scripts/run_fabric_nb.ps1, scripts/run_e2e_test.ps1) read these
# instead of hardcoding GUIDs. Real environment variables take precedence over .env.

# Fabric workspace GUID (from the app URL: app.fabric.microsoft.com/groups/<THIS>/...)
FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000

# Lakehouse GUID (the aws_connect_lh lakehouse in that workspace)
FABRIC_LAKEHOUSE_ID=00000000-0000-0000-0000-000000000000

# Lakehouse display name the notebooks bind to (default: aws_connect_lh)
FABRIC_LAKEHOUSE_NAME=aws_connect_lh

# Python interpreter for the E2E seeder (scripts/e2e_testdata.py). Needs boto3 + AWS creds.
E2E_PYTHON=.\.venv\Scripts\python.exe
